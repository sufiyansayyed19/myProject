SERVICE_NAME=parking-service
HOST=0.0.0.0
PORT=8003
DATABASE_URL=postgresql+psycopg://parking_user:parking_pass@localhost:5432/parking_db

BUSINESS_TIMEZONE=Asia/Kolkata

# RS256 JWT validation (public key only)
JWT_PUBLIC_KEY_PATH=../../keys/jwt_public.pem
JWT_ISSUER=corporate-parking-auth
JWT_AUDIENCE=corporate-parking

# Internal service communication
VEHICLE_SERVICE_URL=http://127.0.0.1:8002
PAYMENT_SERVICE_URL=http://127.0.0.1:8004
PARKING_TO_VEHICLE_TOKEN=dev-parking-to-vehicle-token
PARKING_TO_PAYMENT_TOKEN=dev-parking-to-payment-token
PAYMENT_TO_PARKING_TOKEN=dev-payment-to-parking-token
VEHICLE_TO_PARKING_TOKEN=dev-vehicle-to-parking-token
