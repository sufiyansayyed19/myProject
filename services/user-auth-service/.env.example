SERVICE_NAME=user-auth-service
HOST=0.0.0.0
PORT=8001
DATABASE_URL=postgresql+psycopg://user_auth_user:user_auth_pass@localhost:5432/user_db

# Auth & OTP
COMPANY_EMAIL_DOMAIN=company.com
OTP_HMAC_SECRET=dev-otp-hmac-secret-change-me
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_SENDER_MODE=console
ENVIRONMENT=development

# RS256 JWT & Refresh Sessions
JWT_PRIVATE_KEY_PATH=../../keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=../../keys/jwt_public.pem
JWT_ISSUER=corporate-parking-auth
JWT_AUDIENCE=corporate-parking
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (set real values via local .env, never commit)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_AUTH_SUCCESS_URL=http://localhost:3000/auth/callback
FRONTEND_AUTH_ERROR_URL=http://localhost:3000/auth/error
