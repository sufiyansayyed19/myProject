SERVICE_NAME=payment-service
HOST=0.0.0.0
PORT=8004
DATABASE_URL=postgresql+psycopg://payment_user:payment_pass@localhost:5432/payment_db

# RS256 JWT validation (public key only)
JWT_PUBLIC_KEY_PATH=../../keys/jwt_public.pem
JWT_ISSUER=corporate-parking-auth
JWT_AUDIENCE=corporate-parking

# Internal service communication
PARKING_SERVICE_URL=http://127.0.0.1:8003
PARKING_TO_PAYMENT_TOKEN=dev-parking-to-payment-token
PAYMENT_TO_PARKING_TOKEN=dev-payment-to-parking-token

# Simulated payment controls
PAYMENT_SIMULATION_DEFAULT_OUTCOME=SUCCESS
ENABLE_TEST_PAYMENT_OVERRIDE=true
ENVIRONMENT=development
