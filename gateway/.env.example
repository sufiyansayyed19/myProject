SERVICE_NAME=api-gateway
HOST=0.0.0.0
PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# Downstream business services (bypassed for internal service-to-service calls)
USER_AUTH_SERVICE_URL=http://127.0.0.1:8001
VEHICLE_SERVICE_URL=http://127.0.0.1:8002
PARKING_SERVICE_URL=http://127.0.0.1:8003
PAYMENT_SERVICE_URL=http://127.0.0.1:8004

# RS256 JWT validation (public key only)
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_ISSUER=corporate-parking-auth
JWT_AUDIENCE=corporate-parking
